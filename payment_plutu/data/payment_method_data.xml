<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        The `code` of each method is the Plutu gateway identifier: it is put
        straight into the API path and into the signature lookup, so renaming
        one breaks both.

        `static/img` also carries sadad.png and adfali.png. Those two gateways
        are not registered here because this module does not implement their
        one-time-code exchange; the artwork is in place for when it does.
    -->
    <record id="payment_method_localbankcards" model="payment.method">
        <field name="name">Local Bank Cards</field>
        <field name="code">localbankcards</field>
        <field name="sequence">1</field>
        <field name="image" type="base64" file="payment_plutu/static/img/localbankcards.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="active">True</field>
    </record>

    <record id="payment_method_tlync" model="payment.method">
        <field name="name">T-Lync</field>
        <field name="code">tlync</field>
        <field name="sequence">2</field>
        <field name="image" type="base64" file="payment_plutu/static/img/tlync.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="active">True</field>
    </record>

    <record id="payment_method_mpgs" model="payment.method">
        <field name="name">Mastercard / Visa</field>
        <field name="code">mpgs</field>
        <field name="sequence">3</field>
        <field name="image" type="base64" file="payment_plutu/static/img/mpgs.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="active">True</field>
    </record>

</odoo>
