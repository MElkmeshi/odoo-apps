<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_provider_plutu" model="payment.provider">
        <field name="name">Plutu</field>
        <field name="code">plutu</field>
        <field name="redirect_form_view_id" ref="redirect_form"/>
        <field name="inline_form_view_id" ref="inline_form"/>
        <field name="image_128" type="base64" file="payment_plutu/static/description/icon.png"/>
        <field name="allow_tokenization">False</field>
        <field name="allow_express_checkout">False</field>
        <!--
            Disabled, with no credentials. A provider that installs itself
            already switched on, carrying keys committed to a public repository,
            is one `git clone` away from taking real money to someone else's
            account.
        -->
        <field name="state">disabled</field>
        <field name="payment_method_ids"
               eval="[Command.set([
                         ref('payment_plutu.payment_method_localbankcards'),
                         ref('payment_plutu.payment_method_tlync'),
                         ref('payment_plutu.payment_method_mpgs'),
                         ref('payment_plutu.payment_method_edfali'),
                         ref('payment_plutu.payment_method_sadad'),
                     ])]"
        />
    </record>

</odoo>
