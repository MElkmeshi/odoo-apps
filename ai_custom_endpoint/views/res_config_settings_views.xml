<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai.custom.endpoint</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Anchored on the setting rather than the block because ai_app
                 replaces ai's providers block wholesale, keeping this id. -->
            <xpath expr="//setting[@id='openai_provider']" position="after">
                <setting id="ai_custom_endpoint"
                         string="Use a custom AI endpoint"
                         help="Send requests to an OpenAI-compatible gateway instead of OpenAI"
                         groups="base.group_system">
                    <field name="ai_custom_endpoint_enabled"/>
                    <group invisible="not ai_custom_endpoint_enabled">
                        <div class="flex-grow-1">
                            <field name="ai_openai_base_url"
                                   placeholder="Endpoint, e.g. https://ai.example.com/v1"
                                   nolabel="1" class="w-100"/>
                            <field name="ai_custom_llm_models"
                                   placeholder="claude-opus-5:Claude Opus 5, gpt-5:GPT-5"
                                   nolabel="1" class="w-100 mt-2"/>
                            <button name="action_fetch_ai_models" type="object"
                                    string="Fetch models from endpoint"
                                    icon="fa-refresh" class="btn-link ps-0 mt-2"/>
                        </div>
                    </group>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
