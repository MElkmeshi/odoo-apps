<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_provider_adfali" model="payment.provider">
        <field name="name">Adfali</field>
        <field name="code">adfali</field>
        <field name="image_128" type="base64" file="payment_adfali/static/description/icon.png"/>
        <field name="inline_form_view_id" ref="inline_form"/>
        <field name="allow_tokenization">False</field>
        <field name="allow_express_checkout">False</field>
        <field name="state">disabled</field>
        <field name="payment_method_ids"
               eval="[Command.set([
                         ref('payment_method_adfali_wallet'),
                     ])]"
        />
    </record>

</odoo>
