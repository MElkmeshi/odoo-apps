<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_stock_demand_forecast" model="ir.actions.client">
        <field name="name">Trends&amp;Forecast</field>
        <field name="tag">stock_demand_forecast.manager</field>
    </record>

    <record id="forecast_report_action" model="ir.actions.act_window">
        <field name="name">Forecast Reports</field>
        <field name="res_model">forecast.report</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="forecast_report_view_list" model="ir.ui.view">
        <field name="name">forecast.report.list</field>
        <field name="model">forecast.report</field>
        <field name="arch" type="xml">
            <list string="Forecast Reports">
                <field name="name"/>
                <field name="interval"/>
                <field name="horizon"/>
                <field name="group_by_field"/>
            </list>
        </field>
    </record>

    <record id="forecast_report_view_form" model="ir.ui.view">
        <field name="name">forecast.report.form</field>
        <field name="model">forecast.report</field>
        <field name="arch" type="xml">
            <form string="Forecast Report">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Delivery stats"/></h1>
                    </div>
                    <group>
                        <group string="Historical Data">
                            <field name="interval"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="horizon"/>
                        </group>
                        <group string="Extra Settings">
                            <field name="group_by_field"/>
                            <field name="show_stats_info"/>
                            <field name="hypothesis_testing"/>
                            <field name="shorten_figures"/>
                        </group>
                        <group string="Filters">
                            <field name="state_flags" widget="json"/>
                            <field name="product_ids" widget="many2many_tags"/>
                            <field name="template_ids" widget="many2many_tags"/>
                            <field name="category_ids" widget="many2many_tags"/>
                            <field name="uom_ids" widget="many2many_tags"/>
                            <field name="location_src_ids" widget="many2many_tags"/>
                            <field name="location_dst_ids" widget="many2many_tags"/>
                            <field name="warehouse_ids" widget="many2many_tags"/>
                            <field name="picking_type_ids" widget="many2many_tags"/>
                            <field name="rule_ids" widget="many2many_tags"/>
                            <field name="company_ids" widget="many2many_tags"
                                   groups="base.group_multi_company"/>
                            <field name="extra_domain" widget="json"/>
                        </group>
                        <group string="Models">
                            <field name="model_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
