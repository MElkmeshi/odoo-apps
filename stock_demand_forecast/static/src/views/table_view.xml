<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="stock_demand_forecast.TableView">
        <div class="sdf-table-wrap">
            <table class="sdf-table">
                <thead>
                    <tr>
                        <th></th>
                        <th t-foreach="columns" t-as="s" t-key="s.key + (s.model_id or '')"
                            class="sdf-series-header" t-esc="s.label"/>
                    </tr>
                </thead>
                <tbody>
                    <!-- stats block row -->
                    <t t-if="result.meta.show_stats">
                        <tr class="sdf-stats-row">
                            <td>Stats</td>
                            <td t-foreach="columns" t-as="s" t-key="'stats-' + s.key + (s.model_id or '')">
                                <t t-if="!expanded.keys.includes(s.key)">
                                    <a href="#" t-on-click.prevent="() => this.toggleStats(s.key)">
                                        <i class="fa fa-caret-right"/> Stats
                                    </a>
                                </t>
                                <t t-else="">
                                    <a href="#" t-on-click.prevent="() => this.toggleStats(s.key)">
                                        <i class="fa fa-caret-down"/>
                                    </a><br/>
                                    count: <t t-esc="fmt(s.stats.count)"/><br/>
                                    mean: <t t-esc="fmt(s.stats.mean)"/><br/>
                                    std: <t t-esc="fmt(s.stats.std)"/><br/>
                                    min: <t t-esc="fmt(s.stats.min)"/><br/>
                                    25%: <t t-esc="fmt(s.stats['25%'])"/><br/>
                                    50%: <t t-esc="fmt(s.stats['50%'])"/><br/>
                                    75%: <t t-esc="fmt(s.stats['75%'])"/><br/>
                                    max: <t t-esc="fmt(s.stats.max)"/>
                                </t>
                            </td>
                        </tr>
                    </t>

                    <!-- forecast rows first (newest at top), like the reference app -->
                    <tr t-foreach="rows.forecastLabels" t-as="fl" t-key="'f-' + fl"
                        class="sdf-forecast-row">
                        <td class="sdf-period-cell sdf-forecast-cell" t-esc="fl"/>
                        <td t-foreach="columns" t-as="s" t-key="'fv-' + s.key + (s.model_id or '')"
                            t-att-class="{'sdf-forecast-cell': true}">
                            <t t-esc="fmt(s.forecast[fl_index])"/>
                            <t t-if="s.error">
                                <i class="fa fa-exclamation-triangle sdf-error-icon"
                                   t-att-title="s.error"/>
                            </t>
                        </td>
                    </tr>

                    <!-- history rows, newest first -->
                    <tr t-foreach="rows.histLabels" t-as="hl" t-key="'h-' + hl">
                        <td class="sdf-period-cell" t-esc="hl"/>
                        <td t-foreach="columns" t-as="s" t-key="'hv-' + s.key + (s.model_id or '')"
                            t-esc="fmt(histValue(s, hl_index))"/>
                    </tr>
                </tbody>
            </table>
        </div>
    </t>

</templates>
